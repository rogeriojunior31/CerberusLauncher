{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerberus Launcher",
  "version": "0.10.0",
  "identifier": "app.cerberus.launcher",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cerberus Launcher",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#0b0d13"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Cerberus Launcher",
    "copyright": "© 2026 Cerberus Launcher contributors · MIT",
    "category": "Game",
    "shortDescription": "Launcher de jogos e recomps para PC",
    "longDescription": "Biblioteca da Steam, da Epic e dos seus jogos, recomps instalados e atualizados direto dos desenvolvedores, clássicos no RetroArch, saves com backup e Big Picture Mode.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Cerberus Launcher",
        "installerHooks": "installer/hooks.nsh",
        "customLanguageFiles": { "PortugueseBR": "installer/PortugueseBR.nsh" }
      }
    }
  }
}
