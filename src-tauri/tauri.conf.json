{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerberus Launcher",
  "version": "0.1.0",
  "identifier": "app.cerberus.launcher",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cerberus Launcher",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#0b0d13"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
